@{
    ViewData["Title"] = "File not found";
}

<section class="abef-page">
    <div class="container">
        <h1 class="abef-page-title">File not found</h1>
        <p class="abef-page-lead">
            This file is not available yet. Please check back later or choose another resource.
        </p>
        <div class="abef-page-actions">
            <a class="btn btn-member" asp-controller="KnowledgeHub" asp-action="Resources">Browse resources</a>
        </div>
        <a class="abef-back-link" asp-controller="KnowledgeHub" asp-action="Index">← Back to Knowledge Hub</a>
    </div>
</section>
