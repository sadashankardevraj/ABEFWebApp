@model ABEFWebApp.Models.ContactMessage
@{
    ViewData["Title"] = "Contact Us";
}

<section class="contact-page">
    <div class="container">
        <h1 class="contact-title">Contact Business Excellence Australia</h1>
        <p class="contact-subtitle">Business Excellence Australia • Australian Business Excellence Framework</p>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="auth-status contact-success" role="status">@successMessage</div>
        }

        <div class="contact-layout">
            <div class="contact-form-card">
                <form asp-action="Index" method="post" class="auth-form" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger auth-validation" role="alert"></div>

                    <div class="auth-field">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control auth-input" autocomplete="name" placeholder="Your name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control auth-input" autocomplete="email" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Organisation"></label>
                        <input asp-for="Organisation" class="form-control auth-input" autocomplete="organization" placeholder="Organisation (optional)" />
                        <span asp-validation-for="Organisation" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Message"></label>
                        <textarea asp-for="Message" class="form-control auth-input contact-message" rows="6" placeholder="How can we help?"></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-member auth-submit contact-submit">Send Message</button>
                </form>
            </div>

            <aside class="contact-info-card d-none d-lg-block">
                <h2>Business Excellence Australia</h2>
                <p class="contact-info-line">
                    <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                    Sydney, Australia
                </p>
                <p class="contact-info-line">
                    <i class="bi bi-globe2" aria-hidden="true"></i>
                    <a href="https://www.businessexcellenceaustralia.com.au" target="_blank" rel="noopener noreferrer">
                        businessexcellenceaustralia.com.au
                    </a>
                </p>
                <p class="contact-info-note">
                    Send us a message and our team will get back to you.
                </p>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
