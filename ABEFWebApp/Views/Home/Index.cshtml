@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <div class="container">
        <div class="home-hero-row">
            <div class="home-hero-inner">
                <h1 class="home-hero-title">
                    Advancing Business Excellence<br />
                    Across Australia
                </h1>
                <p class="home-hero-text">
                    Business Excellence Australia helps leaders, teams and organisations build
                    the systems, capability and discipline needed for sustainable performance.
                </p>
                <p class="home-hero-text">
                    Grounded in the Australian Business Excellence Framework, BEA supports
                    organisations to strengthen leadership, align strategy, improve operations and
                    embed continuous improvement across the whole organisation.
                </p>
                <div class="home-hero-actions">
                    <a class="btn btn-member" asp-area="Identity" asp-page="/Account/Register">Become a Member</a>
                    <a class="btn btn-member" href="#">Explore ABEF</a>
                </div>
            </div>

            <aside class="home-hero-aside d-none d-md-block">
                <div class="home-hero-panel">
                    <h2 class="home-hero-panel-title">Start your ABEF journey</h2>
                    <ul class="home-hero-panel-links">
                        <li><a href="#">Why ABEF?</a></li>
                        <li><a href="#">7 Categories</a></li>
                        <li><a href="#">Learn ADRI</a></li>
                        <li><a href="#">Self-Assessment</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="home-why">
    <div class="container">
        <div class="home-why-inner">
            <p class="home-section-label">Why Excellence Matters</p>
            <h2 class="home-why-title">
                Excellence is not an initiative.<br />
                It is how high-performing organisations are led, managed and improved.
            </h2>
            <p class="home-why-text">
                Most organisations are working hard. The challenge is making sure that effort is
                aligned, evidence-based and focused on the outcomes that matter most.
            </p>
            <p class="home-why-text">
                Business excellence gives leaders a practical way to understand how the organisation
                is performing as a whole. It connects leadership, strategy, people, customers,
                processes, data and results into one integrated view.
            </p>
        </div>
    </div>
</section>

<section class="home-audience">
    <div class="container">
        <h2 class="home-audience-title">Who is this for?</h2>
        <div class="home-audience-grid">
            <article class="home-audience-card">
                <i class="bi bi-people-fill home-audience-icon" aria-hidden="true"></i>
                <h3>Leaders &amp; Boards</h3>
                <p>Set direction and govern for sustainable performance.</p>
            </article>
            <article class="home-audience-card">
                <i class="bi bi-tools home-audience-icon" aria-hidden="true"></i>
                <h3>Practitioners</h3>
                <p>Apply the framework in daily improvement work.</p>
            </article>
            <article class="home-audience-card">
                <i class="bi bi-clipboard-check home-audience-icon" aria-hidden="true"></i>
                <h3>Assessors</h3>
                <p>Evaluate organisations using ADRI and the assessment matrix.</p>
            </article>
            <article class="home-audience-card">
                <i class="bi bi-mortarboard-fill home-audience-icon" aria-hidden="true"></i>
                <h3>Educators</h3>
                <p>Teach business excellence concepts and practice.</p>
            </article>
        </div>
    </div>
</section>

<section class="home-explore">
    <div class="container home-explore-inner">
        <h2 class="home-explore-title">Explore the Framework</h2>
        <p class="home-explore-text">
            Discover how the Australian Business Excellence Framework helps organisations improve performance.
        </p>
        <a class="btn btn-member" href="#">Explore ABEF</a>
    </div>
</section>
