@model ABEFWebApp.Models.ViewModels.AbefWhatViewModel
@{
    ViewData["Title"] = "What is the ABEF?";

    string BadgeClass(string type) => type.ToLowerInvariant() switch
    {
        "driver" => "abef-label-driver",
        "enabler" => "abef-label-enabler",
        "result" => "abef-label-result",
        _ => "abef-label-driver"
    };
}

<section class="abef-page">
    <div class="container">
        <nav class="account-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="account-breadcrumb-sep" aria-hidden="true">›</span>
            <a asp-controller="Abef" asp-action="Index">ABEF</a>
            <span class="account-breadcrumb-sep" aria-hidden="true">›</span>
            <span>What is the ABEF?</span>
        </nav>

        <h1 class="abef-page-title">What is the ABEF?</h1>
        <p class="abef-page-lead">
            The framework has seven categories. Two Drivers set direction, four Enablers support how the work gets done, and Results shows the outcomes.
        </p>

        <h2 class="abef-section-heading">The 7 categories</h2>
        <div class="abef-category-grid">
            @foreach (var category in Model.Categories)
            {
                <a class="abef-category-card abef-category-card-link"
                   asp-controller="Categories"
                   asp-action="Details"
                   asp-route-number="@category.Number">
                    <span class="abef-category-number">@category.Number</span>
                    <span class="abef-category-label @BadgeClass(category.Type)">@category.Type</span>
                    <h3>@category.Name</h3>
                    <p>@category.ShortDescription</p>
                </a>
            }
        </div>

        <h2 class="abef-section-heading">The 9 Principles</h2>
        <div class="abef-principles-grid">
            @foreach (var principle in Model.Principles)
            {
                <article class="abef-principle-card">
                    <span class="abef-principle-number">@principle.Number</span>
                    <h3>@principle.Name</h3>
                    <p>@principle.ShortDescription</p>
                </article>
            }
        </div>

        <div class="abef-mini-grid abef-adri-row">
            <article class="abef-mini-card">
                <h2>ADRI</h2>
                <p>Approach, Deployment, Results and Improvement — a simple way to reflect on each item.</p>
            </article>
        </div>

        <a class="abef-back-link" asp-controller="Abef" asp-action="Index">← Back to ABEF</a>
    </div>
</section>
