@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "My Account";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="account-panel-title">Change Password</h2>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="auth-status" role="status">@Model.StatusMessage</div>
}

<form id="change-password-form" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="text-danger auth-validation" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.OldPassword"></label>
        <div class="auth-password-wrap">
            <input asp-for="Input.OldPassword" class="form-control auth-input" autocomplete="current-password" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Show password">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Input.NewPassword"></label>
        <div class="auth-password-wrap">
            <input asp-for="Input.NewPassword" class="form-control auth-input" autocomplete="new-password" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Show password">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <p class="auth-password-hint">
            At least 8 characters, with 1 uppercase, 1 lowercase, 1 number and 1 special character.
        </p>
        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Input.ConfirmPassword"></label>
        <div class="auth-password-wrap">
            <input asp-for="Input.ConfirmPassword" class="form-control auth-input" autocomplete="new-password" />
            <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Show password">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-member auth-submit">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
