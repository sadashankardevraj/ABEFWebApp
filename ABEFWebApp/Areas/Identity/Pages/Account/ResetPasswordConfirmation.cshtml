@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}

<div class="auth-page">
    <div class="auth-card">
        <a class="auth-logo" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/bea-logo.png" alt="Business Excellence Australia" asp-append-version="true" />
        </a>
        <h1 class="auth-title">Password reset</h1>
        <p class="auth-lead">Your password has been reset.</p>
        <div class="auth-links">
            <a asp-page="./Login">Member Login</a>
        </div>
    </div>
</div>
