@page
@model LoginModel

@{
    ViewData["Title"] = "Member Login";
}

<div class="auth-page">
    <div class="auth-card">
        <a class="auth-logo" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/bea-logo.png" alt="Business Excellence Australia" asp-append-version="true" />
        </a>
        <h1 class="auth-title">Member Login</h1>

        <form id="account" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation" role="alert"></div>

            <div class="auth-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password">Password</label>
                <div class="auth-password-wrap">
                    <input asp-for="Input.Password" class="form-control auth-input" autocomplete="current-password" aria-required="true" placeholder="Password" />
                    <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Show password">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="auth-remember">
                <label asp-for="Input.RememberMe">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <button id="login-submit" type="submit" class="btn btn-member auth-submit">Log in</button>

            <div class="auth-links">
                <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Not a member? Register</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
