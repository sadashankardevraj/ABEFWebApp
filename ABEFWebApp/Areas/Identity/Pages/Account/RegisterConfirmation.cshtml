@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your account";
}

<div class="auth-page">
    <div class="auth-card">
        <a class="auth-logo" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/bea-logo.png" alt="Business Excellence Australia" asp-append-version="true" />
        </a>
        <h1 class="auth-title">Confirm your account</h1>
        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="auth-lead">
                This app does not currently have a real email sender registered.
                Normally this would be emailed:
                <a id="confirm-link" href="@Model.EmailConfirmationUrl">Click here to confirm your account</a>
            </p>
        }
        else
        {
            <p class="auth-lead">Please check your email to confirm your account.</p>
        }
        <div class="auth-links">
            <a asp-page="./Login">Member Login</a>
        </div>
    </div>
</div>
