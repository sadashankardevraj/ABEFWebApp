@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
}

<div class="auth-page">
    <div class="auth-card">
        <a class="auth-logo" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/images/bea-logo.png" alt="Business Excellence Australia" asp-append-version="true" />
        </a>
        <h1 class="auth-title">Check your email</h1>
        <p class="auth-lead">Please check your email to reset your password.</p>
        <div class="auth-links">
            <a asp-page="./Login">Back to Member Login</a>
        </div>
    </div>
</div>
